# Copy to .env. Never commit real secrets.

# PostgreSQL. Docker Compose uses the same credentials.
DATABASE_URL="postgresql://lzre:lzre@localhost:5432/lzre?schema=public"

# Auth.js session signing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public site URL used for metadata, emails, and Paystack callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments.
# sandbox: development only. Orders are marked simulated and never paid.
# paystack: live integration. Orders become paid only after a verified webhook.
# Leave PAYSTACK keys empty until you have a Paystack account.
PAYMENT_PROVIDER="sandbox"
ALLOW_PAYMENT_SANDBOX="true"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Email.
# log: save messages in the database and do not claim they were sent.
# resend: send with the Resend API when RESEND_API_KEY is set.
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="LZRE <orders@example.com>"

# Show password-reset links in the server log. Development only.
SHOW_DEV_LINKS="true"

# Require a verified email before login. Off until email delivery works.
REQUIRE_EMAIL_VERIFICATION="false"

# Protects /api/cron/cleanup. Send header: x-cron-secret
CRON_SECRET=""

# Optional S3-compatible storage. Local disk is used when these are empty.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# One-time administrator bootstrap. Used only by `npm run admin:create`.
# Password must be at least 12 characters. Do not commit real values.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional demo customer and seller created by the seed.
# Password must be at least 12 characters. Omit to seed the catalog only.
SEED_DEMO_PASSWORD=""
